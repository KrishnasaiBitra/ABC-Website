# Copy this file to .env and fill in your SMTP credentials.
# NEVER upload .env to GitHub.

# SMTP Configuration (e.g., for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_gmail_app_password_without_spaces

# Target Company Email (where enquiry and applications will be sent)
COMPANY_EMAIL=your_company_email@example.com
