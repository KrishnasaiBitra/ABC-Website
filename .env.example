# Copy this file to .env and fill in your EmailJS credentials.
# NEVER upload .env to GitHub.

# EmailJS credentials (get from https://dashboard.emailjs.com)
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_PRIVATE_KEY=your_private_key_here

# Template IDs (create 4 templates in EmailJS dashboard)
EMAILJS_TEMPLATE_ID_COMPANY=your_contact_notify_template_id
EMAILJS_TEMPLATE_ID_CONFIRM=your_contact_confirm_template_id
EMAILJS_TEMPLATE_ID_JOB_NOTIFY=your_job_notify_template_id
EMAILJS_TEMPLATE_ID_JOB_CONFIRM=your_job_confirm_template_id
